<?xml version="1.0" encoding="utf-8"?>
<!-- Injury entry (opened by long-pressing STOP): team → number → body part → side. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/injuryScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="24dp"
        android:paddingEnd="30dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/txtInjuryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🩹 INJURY · WHICH TEAM?"
            android:textColor="#FF8A80"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtInjurySub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Stoppage is running"
            android:textColor="#9E9E9E"
            android:textSize="10sp" />

        <!-- STEP 1: team -->
        <LinearLayout
            android:id="@+id/layoutTeam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
                <Button
                    android:id="@+id/btnTeamHome"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_margin="2dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#1565C0"
                    android:text="HOME"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnTeamAway"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_margin="2dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#B71C1C"
                    android:text="AWAY"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <!-- STEP 2: player number -->
        <LinearLayout
            android:id="@+id/layoutNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtPlayerNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@android:color/white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPlayerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Type the player number"
                android:textColor="#4CAF50"
                android:textSize="11sp" />

            <!-- NEW: number keypad (tap digits; crown also works) -->
            <LinearLayout
                android:id="@+id/keypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnDigit1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#424242"
                    android:text="1"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnDigit2"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#424242"
                    android:text="2"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnDigit3"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#424242"
                    android:text="3"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnDigit4"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#424242"
                    android:text="4"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnDigit5"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#424242"
                    android:text="5"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnDigit6"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#424242"
                    android:text="6"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnDigit7"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#424242"
                    android:text="7"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnDigit8"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#424242"
                    android:text="8"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnDigit9"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#424242"
                    android:text="9"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnBackspace"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#616161"
                    android:text="⌫"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnDigit0"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#424242"
                    android:text="0"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnNumConfirm"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#2E7D32"
                    android:text="✓"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- STEP 3: body part -->
        <LinearLayout
            android:id="@+id/layoutBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnHead"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_margin="2dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#6D4C41"
                    android:text="HEAD"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnTorso"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_margin="2dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#6D4C41"
                    android:text="TORSO"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnArm"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_margin="2dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#6D4C41"
                    android:text="ARM"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnLeg"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_margin="2dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#6D4C41"
                    android:text="LEG"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- STEP 4: side (arm / leg only) -->
        <LinearLayout
            android:id="@+id/layoutSide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
                <Button
                    android:id="@+id/btnLeft"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_margin="2dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#455A64"
                    android:text="◀ LEFT"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnRight"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_margin="2dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#455A64"
                    android:text="RIGHT ▶"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnInjuryCancel"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:minHeight="0dp"
            android:backgroundTint="#212121"
            android:text="✕ Not an injury"
            android:textColor="#BDBDBD"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
